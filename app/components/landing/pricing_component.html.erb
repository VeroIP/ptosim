<section id="pricing" style="border-top:1px solid var(--color-border-soft);background:var(--color-bg-muted);">
  <div class="ps-container ps-section-lg">
    <div style="text-align:center;margin-bottom:48px;">
      <h2 class="ps-h2" style="margin:0 0 14px;">Pricing</h2>
      <p style="font-size:16px;color:var(--color-ink-soft);margin:0;">
        An annual platform license plus a per-simulation rate. Comparable tools charge about $500 a run.
      </p>
    </div>
    <div class="ps-grid-3" style="gap:22px;align-items:stretch;">
      <% TIERS.each do |tr| %>
        <div class="ps-card" style="padding:30px 28px 32px;display:flex;flex-direction:column;gap:18px;">
          <div>
            <div style="font-size:15px;font-weight:600;margin-bottom:6px;"><%= tr[:name] %></div>
            <div style="font-size:13px;line-height:1.5;color:var(--color-ink-soft);"><%= tr[:who] %></div>
          </div>
          <div>
            <div style="font-family:var(--font-display);font-weight:600;font-size:38px;line-height:1;letter-spacing:-0.02em;"><%= tr[:price] %></div>
            <div style="font-size:12.5px;color:var(--color-ink-softer);margin-top:7px;"><%= tr[:unit] %></div>
          </div>
          <div class="ps-stack" style="gap:9px;padding-top:6px;border-top:1px solid var(--color-border-soft);">
            <% tr[:features].each do |f| %>
              <div style="font-size:13.5px;line-height:1.45;color:var(--color-ink-body);"><%= f %></div>
            <% end %>
          </div>
          <%= render Ui::ButtonComponent.new(href: "#demo", variant: :primary, size: :sm, class: "ps-btn-md").with_content(tr[:cta]) %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section id="metrics" class="ps-container ps-split-metrics ps-section">
  <div>
    <%= render Ui::EyebrowComponent.new(tone: :accent).with_content("Decision data") %>
    <h2 class="ps-h2" style="margin:20px 0 18px;">
      Choose the path with the numbers in front of you.
    </h2>
    <p style="font-size:clamp(15px,1.6vw,16.5px);line-height:1.6;color:var(--color-ink-muted);margin:0 0 26px;text-wrap:pretty;">
      Each simulated path carries a cost, a timeline, and a scope consequence. Compare them side by side, set a house strategy, and give in-house counsel a defensible answer at the start of the case instead of the end.
    </p>
    <div class="ps-stack" style="gap:12px;">
      <% BULLETS.each do |m| %>
        <div style="display:flex;gap:12px;align-items:flex-start;">
          <span style="width:5px;height:5px;border-radius:50%;background:var(--color-accent);margin-top:8px;flex:none;"></span>
          <span style="font-size:14.5px;line-height:1.5;color:var(--color-ink-body);"><%= m %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="ps-card ps-card-soft">
    <div style="padding:18px 24px;border-bottom:1px solid var(--color-border-soft);display:flex;align-items:center;gap:12px;">
      <span style="font-size:14px;font-weight:600;">Path comparison</span>
      <span class="ps-mono" style="font-size:11px;color:var(--color-ink-softer);margin-left:auto;">18/994,207</span>
    </div>
    <div class="ps-stack" style="padding:22px 24px 8px;gap:18px;">
      <% PATHS.each do |p| %>
        <div>
          <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;margin-bottom:8px;">
            <span style="font-size:14px;font-weight:500;color:var(--color-ink-strong);"><%= p[:name] %></span>
            <span class="ps-mono" style="font-size:11.5px;color:var(--color-ink-softer);"><%= p[:meta] %></span>
            <span class="ps-mono" style="font-size:13px;color:var(--color-ink-body);margin-left:auto;"><%= p[:cost] %></span>
          </div>
          <div style="height:9px;border-radius:5px;background:var(--color-accent-tint);overflow:hidden;">
            <div style="height:100%;border-radius:5px;background:var(--color-accent);width:<%= p[:pct] %>%;"></div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="ps-grid-3" style="margin-top:14px;padding:18px 24px;border-top:1px solid var(--color-border-soft);background:var(--color-bg-subtle);gap:20px;">
      <% TILES.each do |t| %>
        <div>
          <div class="ps-mono" style="font-size:10px;letter-spacing:0.09em;text-transform:uppercase;color:var(--color-ink-faint);margin-bottom:7px;"><%= t[:label] %></div>
          <div style="font-family:var(--font-display);font-weight:500;font-size:26px;line-height:1;"><%= t[:value] %></div>
        </div>
      <% end %>
    </div>
  </div>
</section>

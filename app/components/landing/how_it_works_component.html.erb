<section id="how" class="ps-container ps-section">
  <div style="display:flex;align-items:baseline;gap:20px;margin-bottom:52px;">
    <h2 class="ps-h2" style="margin:0;">How it works</h2>
    <p style="font-size:15px;color:var(--color-ink-soft);margin:0 0 0 auto;max-width:38ch;text-align:right;">
      Four steps, one afternoon. Works for new filings and for cases already under rejection.
    </p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px;">
    <% STEPS.each do |st| %>
      <div style="border-top:2px solid var(--color-accent);padding-top:20px;">
        <div class="ps-mono" style="font-size:11px;color:var(--color-accent);margin-bottom:14px;"><%= st[:n] %></div>
        <h3 class="ps-h3" style="margin:0 0 10px;"><%= st[:title] %></h3>
        <p style="font-size:14px;line-height:1.55;color:var(--color-ink-muted);margin:0;text-wrap:pretty;"><%= st[:body] %></p>
      </div>
    <% end %>
  </div>
</section>

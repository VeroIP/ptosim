<section id="rounds" style="background:var(--color-dark-bg);color:var(--color-dark-fg);">
  <div class="ps-container ps-section-lg">
    <div style="max-width:60ch;margin-bottom:46px;">
      <%= render Ui::EyebrowComponent.new(tone: :dark).with_content("The record") %>
      <h2 class="ps-h2" style="margin:20px 0 18px;color:var(--color-dark-fg);">
        Every round, with the examiner's reasoning attached.
      </h2>
      <p style="font-size:clamp(15px,1.6vw,17px);line-height:1.55;color:var(--color-dark-fg-muted);margin:0;text-wrap:pretty;">
        You see the rejection, the response, and exactly which claim language moved. Take the allowance at the end, or stop at an earlier round that keeps more scope.
      </p>
    </div>

    <div style="border:1px solid var(--color-border-dark);border-radius:var(--radius-xl);overflow:hidden;background:oklch(0.96 0.006 250 / 0.03);">
      <div class="ps-mono" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:16px 22px;border-bottom:1px solid var(--color-border-dark);font-size:11.5px;color:var(--color-dark-fg-soft);">
        <span>SIM-4471 · 18/994,207</span>
        <span style="color:oklch(0.6 0.01 250);">strategy: minimize rounds</span>
        <span style="margin-left:auto;color:var(--color-success-light);">allowed at round 3</span>
      </div>
      <% ROUNDS.each do |rd| %>
        <div style="border-bottom:1px solid var(--color-border-dark-soft);">
          <div class="ps-round-row" style="padding:18px 22px;cursor:pointer;">
            <span class="ps-mono ps-round-id" style="font-size:12.5px;color:var(--color-dark-accent);"><%= rd[:id] %></span>
            <span class="ps-round-headline" style="font-size:15px;color:var(--color-dark-fg);"><%= rd[:headline] %></span>
            <span class="ps-round-posture" style="font-size:13px;color:var(--color-dark-fg-soft);"><%= rd[:posture] %></span>
            <span class="ps-mono ps-round-scope" style="font-size:12px;color:var(--color-dark-fg-muted);"><%= rd[:scope] %></span>
          </div>
          <% if rd[:open] %>
            <div class="ps-round-detail" style="padding:4px 22px 28px;">
              <div style="border-left:2px solid var(--color-dark-accent);padding-left:18px;">
                <div class="ps-mono" style="font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-dark-accent);margin-bottom:12px;">Examiner reasoning</div>
                <p style="font-size:14px;line-height:1.6;color:oklch(0.85 0.01 250);margin:0;text-wrap:pretty;"><%= rd[:reasoning] %></p>
              </div>
              <div style="border-left:2px solid oklch(0.96 0.006 250 / 0.2);padding-left:18px;">
                <div class="ps-mono" style="font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-dark-fg-soft);margin-bottom:12px;">Claim 1 delta</div>
                <p class="ps-mono" style="font-size:12.5px;line-height:1.75;color:oklch(0.86 0.01 250);margin:0 0 16px;word-break:break-word;">
                  <%= rd[:delta_before] %><span style="color:var(--color-success-lighter);"><%= rd[:delta_add] %></span>
                </p>
                <div style="display:flex;flex-wrap:wrap;gap:10px;">
                  <span style="font-size:12.5px;font-weight:500;color:var(--color-ink);background:oklch(0.94 0.006 250);padding:8px 14px;border-radius:var(--radius-md);">Stop at <%= rd[:id] %></span>
                  <span style="font-size:12.5px;color:oklch(0.9 0.01 250);border:1px solid oklch(0.96 0.006 250 / 0.25);padding:8px 14px;border-radius:var(--radius-md);">Export response</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div style="margin-top:16px;font-size:12.5px;color:var(--color-dark-fg-faint);">Illustrative simulation. Click a round to open it.</div>
  </div>
</section>

<section id="demo" class="ps-container ps-section-lg" style="text-align:center;">
  <h2 class="ps-display ps-display-md" style="margin:0 auto 20px;max-width:22ch;">
    Bring one pending case. We'll run it.
  </h2>
  <p style="font-size:clamp(15px,1.6vw,17px);line-height:1.55;color:var(--color-ink-muted);margin:0 auto 32px;max-width:52ch;">
    A 30-minute walkthrough on your own file, with the full simulated record to keep.
  </p>
  <div style="display:flex;gap:12px;justify-content:center;align-items:center;flex-wrap:wrap;">
    <%= render Ui::ButtonComponent.new(href: "#demo", variant: :primary).with_content("Book a demo") %>
    <a href="mailto:hello@ptosim.com" style="font-size:15px;color:var(--color-ink-muted);">or email hello@ptosim.com</a>
  </div>
</section>

<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sign in — PTO Sim" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="background:var(--color-bg-muted);min-height:100vh;">
    <main style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 20px;">
      <a href="/" style="display:flex;align-items:baseline;gap:9px;margin-bottom:28px;color:var(--color-ink);">
        <span style="font-family:var(--font-display);font-weight:700;font-size:22px;letter-spacing:-0.02em;">PTO&nbsp;Sim</span>
        <% if request.path.start_with?("/console") %>
          <%= render Ui::BadgeComponent.new(label: "Console") %>
        <% end %>
      </a>

      <div class="ps-card ps-card-soft" style="width:100%;max-width:420px;padding:32px;">
        <% if flash[:alert] %>
          <div style="margin-bottom:20px;padding:12px 14px;border-radius:var(--radius-md);background:oklch(0.96 0.04 25);color:oklch(0.4 0.15 25);font-size:14px;line-height:1.5;">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <% if flash[:notice] %>
          <div style="margin-bottom:20px;padding:12px 14px;border-radius:var(--radius-md);background:oklch(0.95 0.05 150);color:oklch(0.35 0.12 150);font-size:14px;line-height:1.5;">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <%= yield %>
      </div>

      <% if request.path.start_with?("/console") %>
        <div style="margin-top:20px;font-size:12px;color:var(--color-ink-softer);">
          Secure area. All activity is logged.
        </div>
      <% end %>
    </main>
  </body>
</html>

<% content_for :title, "Invite user — Console" %>

<div style="max-width:520px;">
  <h1 class="ps-h2" style="margin:0 0 6px;">Invite user</h1>
  <p style="font-size:14px;color:var(--color-ink-soft);margin:0 0 24px;">
    They'll set their own password and enroll two-factor.
    <span class="ps-mono" style="color:var(--color-ink);"><%= @organization.name %></span>
  </p>

  <div class="ps-card" style="padding:24px;">
    <%= form_with model: [:console, @organization, @user], local: true, url: console_organization_users_path(@organization) do |f| %>
      <% if @user.errors.any? %>
        <div style="margin-bottom:16px;padding:10px 12px;border-radius:var(--radius-md);background:oklch(0.96 0.04 25);color:oklch(0.4 0.15 25);font-size:13px;">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--color-ink-strong);">
        Email address
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "off",
              style: "font:inherit;padding:10px 12px;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);background:#fff;" %>
      </label>

      <div style="margin-top:22px;display:flex;gap:10px;">
        <%= f.submit "Generate invite", class: "ps-btn ps-btn-md ps-btn-primary" %>
        <%= link_to "Cancel", console_organization_path(@organization), class: "ps-btn ps-btn-md ps-btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>

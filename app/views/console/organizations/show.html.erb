<% content_for :title, "#{@organization.name} — Console" %>

<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px;flex-wrap:wrap;gap:12px;">
  <div>
    <h1 class="ps-h2" style="margin:0;"><%= @organization.name %></h1>
    <div class="ps-mono" style="font-size:12px;color:var(--color-ink-softer);margin-top:4px;"><%= @organization.slug %></div>
  </div>
  <%= link_to "Invite user", new_console_organization_user_path(@organization),
        class: "ps-btn ps-btn-sm ps-btn-primary" %>
</div>

<p style="font-size:14px;color:var(--color-ink-soft);margin:0 0 24px;">
  Created <%= @organization.created_at.to_date.iso8601 %>
</p>

<div class="ps-card">
  <div style="padding:16px 22px;border-bottom:1px solid var(--color-border-soft);font-size:14px;font-weight:600;">
    Members
  </div>
  <% if @members.any? %>
    <% @members.each do |m| %>
      <%= link_to console_organization_user_path(@organization, m),
            style: "display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:16px;align-items:center;padding:14px 22px;border-bottom:1px solid var(--color-border-soft);color:var(--color-ink);" do %>
        <div class="ps-mono" style="font-size:13.5px;"><%= m.email_address %></div>
        <span class="ps-mono" style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-ink-softer);"><%= m.role %></span>
        <span class="ps-mono" style="font-size:11.5px;color:<%= m.invitation_pending? ? 'var(--color-accent)' : 'var(--color-ink-softer)' %>;">
          <%= m.invitation_pending? ? "invited" : "active" %>
        </span>
      <% end %>
    <% end %>
  <% else %>
    <div style="padding:32px 22px;text-align:center;color:var(--color-ink-soft);font-size:14px;">
      No members yet.
      <%= link_to "Invite the first one →", new_console_organization_user_path(@organization), style: "margin-left:6px;" %>
    </div>
  <% end %>
</div>

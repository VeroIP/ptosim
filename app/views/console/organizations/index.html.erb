<% content_for :title, "Organizations — Console" %>

<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
  <h1 class="ps-h2" style="margin:0;">Organizations</h1>
  <%= link_to "New organization", new_console_organization_path, class: "ps-btn ps-btn-sm ps-btn-primary" %>
</div>

<div class="ps-card">
  <% if @organizations.any? %>
    <% @organizations.each do |org| %>
      <%= link_to console_organization_path(org),
            style: "display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:16px;padding:14px 22px;border-bottom:1px solid var(--color-border-soft);color:var(--color-ink);" do %>
        <div>
          <div style="font-size:14px;font-weight:500;"><%= org.name %></div>
          <div class="ps-mono" style="font-size:11.5px;color:var(--color-ink-softer);margin-top:2px;"><%= org.slug %></div>
        </div>
        <span class="ps-mono" style="font-size:11.5px;color:var(--color-ink-softer);"><%= org.users.count %> users</span>
        <span class="ps-mono" style="font-size:11.5px;color:var(--color-ink-softer);"><%= org.created_at.to_date.iso8601 %></span>
      <% end %>
    <% end %>
  <% else %>
    <div style="padding:32px 22px;text-align:center;color:var(--color-ink-soft);font-size:14px;">
      No organizations yet.
    </div>
  <% end %>
</div>
